# Used only by `npm run test:e2e` (see test/global-setup.ts) — points at a
# throwaway database on the same local cluster as dev (backend/README.md,
# "Local dev database"), never the dev database itself. Safe to commit: no
# real secrets, and the whole database gets migrated from scratch by the
# test run.
DATABASE_URL="postgresql://campus:campus_dev_password@localhost:5433/campus_test?schema=public"

JWT_ACCESS_SECRET="test-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
PAYMENT_WEBHOOK_SECRET="test-webhook-secret"
NODE_ENV="test"
