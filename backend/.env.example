# Copy to .env and fill in real values. Never commit .env.

# Postgres — matches docker-compose.yml's db service by default
DATABASE_URL="postgresql://campus:campus_dev_password@localhost:5432/campus?schema=public"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d" # refresh tokens are opaque + DB-backed, not JWTs — this just sets how long one is valid

# App
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Payment gateway (SSLCommerz) — sandbox credentials, never production keys in .env.example
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX=true

# Placeholder webhook signing secret until the real gateway integration
# lands — see src/modules/fees/payment-gateway.util.ts
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# SMS gateway — provider TBD, see docs/specification.html §09
SMS_API_KEY=""

# Firebase Cloud Messaging
FCM_SERVER_KEY=""
